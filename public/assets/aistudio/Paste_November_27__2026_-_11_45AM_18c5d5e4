      };
      const sorted = [...options].sort((a, b) => rank(a) - rank(b) || a.id.localeCompare(b.id));
      const best = sorted.filter(t => rank(t) <= rank(sorted[0]) + 1);
      const pick = best[(d + input.variety) % best.length];
      used[pick.id] = (used[pick.id] ?? 0) + 1;
