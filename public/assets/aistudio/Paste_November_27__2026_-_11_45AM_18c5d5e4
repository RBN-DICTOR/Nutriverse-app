        <circle r="4.15" fill="#b88f52" /><circle r="3.95" fill="none" stroke="#123b2a" strokeWidth=".18" strokeDasharray=".22 .1" />
        <circle r="3.5" fill="#f7f2e4" onClick={onPlateClick} /><circle r="3.05" fill="none" stroke="#d8d0bb" strokeWidth=".05" />
