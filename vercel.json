{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run typecheck && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/((?!index).*)", "destination": "/api/index?__api_path=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
